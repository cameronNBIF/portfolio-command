{
  "name": "portfolio-command",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "db:up": "docker compose up -d db --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @portfolio-command/db",
    "db:seed": "npm run seed -w @portfolio-command/db",
    "db:generate": "tsx packages/db/src/generate/run.ts",
    "db:types": "kysely-codegen --dialect postgres --default-schema pc --include-pattern \"pc.*\" --out-file packages/db/src/generated/db.ts",
    "import:fixture": "npm run import:contract -w @portfolio-command/api",
    "fixture:purge": "tsx packages/api/src/import/purge-cli.ts",
    "affinity:probe": "tsx functions/src/affinity/probe.ts",
    "affinity:vocab": "tsx functions/src/affinity/vocabularies.ts",
    "visible:probe": "tsx functions/src/visible/probe.ts",
    "visible:sync": "tsx functions/src/visible/sync-cli.ts",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @portfolio-command/web",
    "affinity:sync": "tsx functions/src/affinity/sync-cli.ts",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate && npm run db:seed && npm run affinity:sync && npm run visible:sync && npm run db:generate"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
