# Copy to .env and fill in. .env is gitignored; never commit real values (CLAUDE.md: no secrets in code).
# Local Docker Postgres (docker-compose.yml)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio_command
POSTGRES_PORT=5432

# Used by db:migrate, db:seed and db:types (kysely-codegen). Must agree with the values above.
DATABASE_URL=postgres://portfolio:change-me@localhost:5432/portfolio_command

# --- Authentication (ADR-005) ---------------------------------------------
# entra = validate the MSAL bearer token against the tenant. dev = trust
# DEV_PRINCIPAL_EMAIL. AUTH_MODE=dev is refused when NODE_ENV=production.
AUTH_MODE=dev

# Local development principal. Must match an app_user row; set DEV_ADMIN_EMAIL
# and re-run db:seed to create one. Use your own address, not the system
# principal -- audit_log has to tell a person from an automated writer.
DEV_ADMIN_EMAIL=
DEV_PRINCIPAL_EMAIL=

# Entra ID app registration. Neither value is a secret (both ship in the
# frontend bundle for MSAL), but they are environment configuration and live
# here rather than in code. Required when AUTH_MODE=entra.
#
# ROLES DO NOT COME FROM ENTRA. They come from app_user.role, so the app
# registration needs sign-in configured and nothing else -- no app roles, no
# role assignments. See packages/api/src/auth/principal.ts.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Affinity REST API v2 (nightly sync, phase A4)
AFFINITY_API_KEY=
