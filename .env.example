# Copy to .env and fill in. .env is gitignored; never commit real values (CLAUDE.md: no secrets in code).
# Local Docker Postgres (docker-compose.yml)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio_command
POSTGRES_PORT=5432

# Used by db:migrate, db:seed and db:types (kysely-codegen). Must agree with the values above.
DATABASE_URL=postgres://portfolio:change-me@localhost:5432/portfolio_command

# Affinity REST API v2 (nightly sync, phase A4)
AFFINITY_API_KEY=
